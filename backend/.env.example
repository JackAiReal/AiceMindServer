# AiceMind Admin Backend 环境配置模板
# 复制为 .env 并填入实际值

# 数据库路径（默认 data/admin_console.db）
# AICEMIND_DB_URL=sqlite:///data/admin_console.db

# Membership 登录/权限接口
MEMBERSHIP_API_BASE_URL=https://membership.8188811.xyz/api
MEMBERSHIP_APP_CODE=AiceMind
MEMBERSHIP_APP_NAME=AiceMind
MEMBERSHIP_SHARE_URL=https://membership.8188811.xyz/share/XXXXXXXXXX
MEMBERSHIP_DEFAULT_SHARE_TOKEN=XXXXXXXXXX
MEMBERSHIP_SOURCE_APP_CODE=AiceMind
MEMBERSHIP_SITE_BASE_URL=https://membership.8188811.xyz
